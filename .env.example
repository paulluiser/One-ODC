# Use distinct values in development, staging, and production. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3001
# Optional backend-only key for administrator invitations. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Local invitation testing only. Replace APP_URL and hosted Auth redirect settings before team rollout.
# Supabase default emails work; branded templates require custom SMTP or an eligible plan.

# Supabase Storage reuses the URL/publishable key above and current user sessions.
# Private bucket: one-odc-attachments. No separate storage secret required.

# Enable only after phase1_file_limit migration and authenticated staging verification.
ONE_ODC_ATTACHMENTS_ENABLED=false

# Enable only after the space_management migration and authenticated verification.
ONE_ODC_SPACES_ENABLED=false

# Staging-only until the project_monitoring migration and acceptance checks pass.
ONE_ODC_MONITORING_ENABLED=false

# Enable only after the quotation migration is applied. Server-only flag.
ONE_ODC_QUOTATIONS_ENABLED=false

# Server-only financial feature: enable only after the finance migration.
ONE_ODC_FINANCE_ENABLED=false

# Enable only after the Phase 3E resources/storage migration.
ONE_ODC_RESOURCES_ENABLED=false

# Enable after Phase 4A commercial closure/handoff migration.
ONE_ODC_HANDOFF_ENABLED=false

# Enable only after Phase 4B supplier/logistics migration.
ONE_ODC_LOGISTICS_ENABLED=false

# Enable after both Phase 4C installation/completion and operational cycle state migrations.
ONE_ODC_INSTALLATIONS_ENABLED=false

# Enable after consolidated_calendar migration; server-only.
ONE_ODC_CALENDAR_ENABLED=false

# Rebuilt Gold frontend and role/analytics surfaces; enable after matching migrations.
ONE_ODC_UI_R0_ENABLED=false
ONE_ODC_DASHBOARDS_ENABLED=false
ONE_ODC_ANALYTICS_ENABLED=false
