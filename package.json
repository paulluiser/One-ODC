{
  "name": "one-odc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "brand:build": "node scripts/build-brand.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:staging:browser": "playwright test --config playwright.staging.config.ts",
    "staging:provision": "node scripts/provision-staging-tests.mjs",
    "postinstall": "node scripts/prepare-optimization.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "next": "16.4.1",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tus-js-client": "4.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.9",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "opentype.js": "2.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
